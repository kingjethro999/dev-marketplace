# Security patterns for .gitignore
# Generated by repo-sec skill
# Add these to your .gitignore to prevent committing secrets

# Private keys and certificates
*.key
*.pem
*.p12
*.pfx
*.cer
*.crt
*.der
*.p7b
*.p7c
*.p7r
*.spc
id_rsa
id_dsa
id_ecdsa
id_ed25519
id_ecdsa_sk
id_ed25519_sk
ssh_host_*_key
ssh_host_*_key.pub

# Environment files
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# Secrets and credentials
*.secret
*.secrets
*.token
*.tokens
*.credential
*.credentials
*.password
*.passwords
*_secret
*_token
*_credential
*_password

# AWS
.aws/credentials
.aws/config
*.aws/credentials
*.aws/config

# GCP
*.json
gcloud/credentials
application_default_credentials.json

# Azure
.azure/credentials

# Docker
.dockercfg
.docker/config.json

# Kubernetes
.kube/config
*.kubeconfig

# Terraform
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
.terraform/
terraform.tfstate.backup

# Database
*.sql
*.dump
*.backup
*.bak

# Logs (may contain sensitive data)
*.log
logs/
*.log.*

# IDE/editor (may contain paths, tokens)
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Package managers (may contain tokens in lockfiles)
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.lerna-debug.log*

# Build artifacts
dist/
build/
*.tsbuildinfo
.eslintcache

# Coverage
coverage/
.nyc_output/

# Test artifacts
*.lcov
*.coverage

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Cache
.cache/
.node_cache/
*.cache

# Vendor
vendor/
node_modules/

# Local config
local.config.js
local.config.ts
config.local.js
config.local.ts

# API keys and tokens in code (patterns to watch for)
# These are patterns - actual files should not be committed
# API_KEY=*
# SECRET_KEY=*
# ACCESS_TOKEN=*
# REFRESH_TOKEN=*
# PRIVATE_KEY=*