{
  "scan": {
    "args": ["--json"],
    "failOn": ["critical", "high"],
    "minLaunchConfidence": 0,
    "minRealityScore": 0,
    "minPerceivedPerformance": 0
  },
  "review": {
    "deep": false,
    "failOn": ["critical", "high", "medium"]
  },
  "ready": {
    "minLaunchConfidence": 60,
    "minRealityScore": 50,
    "minPerceivedPerformance": 70,
    "allowWarnings": true
  },
  "sarif": {
    "enabled": true,
    "outputFile": "periderm-results.sarif",
    "category": "periderm"
  },
  "github": {
    "uploadSarif": true,
    "tokenEnv": "GITHUB_TOKEN"
  }
}