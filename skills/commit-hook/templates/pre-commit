#!/bin/sh
# Pre-commit hook with Periderm CLI integration
# Auto-generated by commit-hook skill

# Find skill location
SKILL_DIR=".agents/skills/commit-hook"
[ -d "$SKILL_DIR" ] || SKILL_DIR=".claude/skills/commit-hook"
[ -d "$SKILL_DIR" ] || SKILL_DIR=".gemini/skills/commit-hook"
[ -d "$SKILL_DIR" ] || { echo "commit-hook skill not found"; exit 1; }

# Load config
CONFIG_FILE="$SKILL_DIR/../../commit-hook.json"
if [ -f "$CONFIG_FILE" ]; then
  PERIDERM_SCAN=$(node -e "console.log(JSON.parse(require('fs').readFileSync('$CONFIG_FILE')).preCommit.peridermScan)")
  PERIDERM_ARGS=$(node -e "console.log(JSON.parse(require('fs').readFileSync('$CONFIG_FILE')).preCommit.peridermArgs.join(' '))")
  FAIL_ON=$(node -e "console.log(JSON.parse(require('fs').readFileSync('$CONFIG_FILE')).preCommit.failOn.join(','))")
  LINT=$(node -e "console.log(JSON.parse(require('fs').readFileSync('$CONFIG_FILE')).preCommit.lint)")
  TYPECHECK=$(node -e "console.log(JSON.parse(require('fs').readFileSync('$CONFIG_FILE')).preCommit.typecheck)")
  TESTS=$(node -e "console.log(JSON.parse(require('fs').readFileSync('$CONFIG_FILE')).preCommit.tests.join(' '))")
  TIMEOUT=$(node -e "console.log(JSON.parse(require('fs').readFileSync('$CONFIG_FILE')).preCommit.timeout)")
else
  PERIDERM_SCAN=true
  PERIDERM_ARGS="--staged --json"
  FAIL_ON="critical,high"
  LINT=true
  TYPECHECK=true
  TESTS="unit"
  TIMEOUT=60000
fi

echo "🔍 Running pre-commit checks..."

# Periderm scan on staged files
if [ "$PERIDERM_SCAN" = "true" ]; then
  echo "  Running Periderm scan on staged changes..."
  periderm scan $PERIDERM_ARGS > /tmp/periderm-pre-commit.json 2>&1
  SCAN_EXIT=$?
  cat /tmp/periderm-pre-commit.json

  # Check for failures
  node -e "
    const fs = require('fs');
    try {
      const data = JSON.parse(fs.readFileSync('/tmp/periderm-pre-commit.json'));
      const findings = data.findings || [];
      const failOn = '$FAIL_ON'.split(',');
      for (const sev of failOn) {
        const count = findings.filter(f => (f.severity || '').toLowerCase() === sev).length;
        if (count > 0) {
          console.error('✖ Pre-commit blocked:', count, sev, 'finding(s)');
          process.exit(1);
        }
      }
      console.log('✓ Periderm scan passed');
    } catch (e) {
      // Non-JSON output, check text
      const text = fs.readFileSync('/tmp/periderm-pre-commit.json', 'utf8');
      if (text.includes('DO NOT LAUNCH') || text.includes('critical') || text.includes('high')) {
        console.error('✖ Pre-commit blocked by Periderm');
        process.exit(1);
      }
      console.log('✓ Periderm scan passed (text mode)');
    }
  " || exit 1
fi

# Lint
if [ "$LINT" = "true" ] && [ -f package.json ]; then
  echo "  Running lint..."
  npm run lint --if-present || exit 1
fi

# Typecheck
if [ "$TYPECHECK" = "true" ] && [ -f package.json ]; then
  echo "  Running typecheck..."
  npm run typecheck --if-present || exit 1
fi

# Tests
if [ -n "$TESTS" ] && [ -f package.json ]; then
  for test in $TESTS; do
    echo "  Running $test tests..."
    npm run test:$test --if-present || npm run test --if-present -- --testPathPattern=$test || exit 1
  done
fi

echo "✅ Pre-commit checks passed"
exit 0