#!/bin/sh
# Pre-push hook with Periderm CLI integration
# Auto-generated by commit-hook skill

set -u

PERIDERM_SCAN="{{PERIDERM_SCAN}}"
PERIDERM_REVIEW="{{PERIDERM_REVIEW}}"
PERIDERM_ARGS="{{PERIDERM_ARGS}}"
FAIL_ON="{{FAIL_ON}}"
TESTS="{{TESTS}}"
BUILD="{{BUILD}}"
TIMEOUT="{{TIMEOUT}}"

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
CONFIG_FILE="$REPO_ROOT/commit-hook.json"
if [ -f "$CONFIG_FILE" ] && command -v node >/dev/null 2>&1; then
  eval "$(node -e '
    const fs = require("fs");
    try {
      const cfg = JSON.parse(fs.readFileSync(process.argv[1], "utf8")).prePush || {};
      const sh = (v) => JSON.stringify(String(v));
      if (cfg.peridermScan !== undefined) console.log("PERIDERM_SCAN=" + sh(Boolean(cfg.peridermScan)));
      if (cfg.peridermReview !== undefined) console.log("PERIDERM_REVIEW=" + sh(Boolean(cfg.peridermReview)));
      if (Array.isArray(cfg.peridermArgs)) console.log("PERIDERM_ARGS=" + sh(cfg.peridermArgs.join(" ")));
      if (Array.isArray(cfg.failOn)) console.log("FAIL_ON=" + sh(cfg.failOn.join(",")));
      if (Array.isArray(cfg.tests)) console.log("TESTS=" + sh(cfg.tests.join(" ")));
      if (cfg.build !== undefined) console.log("BUILD=" + sh(Boolean(cfg.build)));
      if (cfg.timeout !== undefined) console.log("TIMEOUT=" + sh(cfg.timeout));
    } catch {}
  ' "$CONFIG_FILE")"
fi

echo "Running pre-push checks..."

if [ "$PERIDERM_SCAN" = "true" ]; then
  if command -v periderm >/dev/null 2>&1; then
    TMP_OUT=$(mktemp)
    trap 'rm -f "$TMP_OUT"' EXIT
    echo "  Running Periderm full scan..."
    # shellcheck disable=SC2086
    periderm scan $PERIDERM_ARGS > "$TMP_OUT" 2>&1
    cat "$TMP_OUT"

    node -e '
      const fs = require("fs");
      const outPath = process.argv[1];
      const failOn = process.argv[2].split(",").map((s) => s.trim().toLowerCase()).filter(Boolean);
      const raw = fs.readFileSync(outPath, "utf8");
      try {
        const data = JSON.parse(raw);
        const findings = data.findings || [];
        for (const sev of failOn) {
          const count = findings.filter((f) => String(f.severity || "").toLowerCase() === sev).length;
          if (count > 0) {
            console.error("✖ Push blocked:", count, sev, "finding(s)");
            process.exit(1);
          }
        }
        console.log("✓ Periderm scan passed");
      } catch {
        if (raw.includes("DO NOT LAUNCH")) {
          console.error("✖ Push blocked by Periderm");
          process.exit(1);
        }
        console.log("✓ Periderm scan passed (text mode)");
      }
    ' "$TMP_OUT" "$FAIL_ON" || exit 1
  else
    echo "  ⚠ periderm-cli not installed; skipping Periderm scan"
  fi
fi

if [ "$PERIDERM_REVIEW" = "true" ] && command -v periderm >/dev/null 2>&1; then
  echo "  Running Periderm deep review..."
  # shellcheck disable=SC2086
  periderm review --deep $PERIDERM_ARGS 2>&1 | head -n 100
fi

if [ "$BUILD" = "true" ] && [ -f "$REPO_ROOT/package.json" ]; then
  echo "  Running build..."
  npm run build --if-present || exit 1
fi

if [ -n "$TESTS" ] && [ -f "$REPO_ROOT/package.json" ]; then
  for t in $(echo "$TESTS" | tr ',' ' '); do
    [ -z "$t" ] && continue
    echo "  Running $t tests..."
    if [ "$t" = "all" ]; then
      npm test --if-present || exit 1
    else
      npm run "test:$t" --if-present || exit 1
    fi
  done
fi

echo "✓ Pre-push checks passed"
exit 0
