#!/bin/sh
# Pre-push hook with Periderm CLI integration
# Auto-generated by commit-hook skill

SKILL_DIR=".agents/skills/commit-hook"
[ -d "$SKILL_DIR" ] || SKILL_DIR=".claude/skills/commit-hook"
[ -d "$SKILL_DIR" ] || SKILL_DIR=".gemini/skills/commit-hook"
[ -d "$SKILL_DIR" ] || { echo "commit-hook skill not found"; exit 1; }

CONFIG_FILE="$SKILL_DIR/../../commit-hook.json"
if [ -f "$CONFIG_FILE" ]; then
  PERIDERM_SCAN=$(node -e "console.log(JSON.parse(require('fs').readFileSync('$CONFIG_FILE')).prePush.peridermScan)")
  PERIDERM_REVIEW=$(node -e "console.log(JSON.parse(require('fs').readFileSync('$CONFIG_FILE')).prePush.peridermReview)")
  PERIDERM_ARGS=$(node -e "console.log(JSON.parse(require('fs').readFileSync('$CONFIG_FILE')).prePush.peridermArgs.join(' '))")
  FAIL_ON=$(node -e "console.log(JSON.parse(require('fs').readFileSync('$CONFIG_FILE')).prePush.failOn.join(','))")
  TESTS=$(node -e "console.log(JSON.parse(require('fs').readFileSync('$CONFIG_FILE')).prePush.tests.join(' '))")
  BUILD=$(node -e "console.log(JSON.parse(require('fs').readFileSync('$CONFIG_FILE')).prePush.build)")
  TIMEOUT=$(node -e "console.log(JSON.parse(require('fs').readFileSync('$CONFIG_FILE')).prePush.timeout)")
else
  PERIDERM_SCAN=true
  PERIDERM_REVIEW=true
  PERIDERM_ARGS="--json"
  FAIL_ON="critical,high"
  TESTS="all"
  BUILD=true
  TIMEOUT=300000
fi

echo "🚀 Running pre-push checks..."

# Periderm full scan
if [ "$PERIDERM_SCAN" = "true" ]; then
  echo "  Running Periderm full scan..."
  periderm scan $PERIDERM_ARGS > /tmp/periderm-pre-push.json 2>&1
  cat /tmp/periderm-pre-push.json

  node -e "
    const fs = require('fs');
    try {
      const data = JSON.parse(fs.readFileSync('/tmp/periderm-pre-push.json'));
      const findings = data.findings || [];
      const failOn = '$FAIL_ON'.split(',');
      for (const sev of failOn) {
        const count = findings.filter(f => (f.severity || '').toLowerCase() === sev).length;
        if (count > 0) {
          console.error('✖ Push blocked:', count, sev, 'finding(s)');
          process.exit(1);
        }
      }
      console.log('✓ Periderm scan passed');
    } catch (e) {
      const text = fs.readFileSync('/tmp/periderm-pre-push.json', 'utf8');
      if (text.includes('DO NOT LAUNCH')) {
        console.error('✖ Push blocked by Periderm');
        process.exit(1);
      }
      console.log('✓ Periderm scan passed (text mode)');
    }
  " || exit 1
fi

# Periderm deep review
if [ "$PERIDERM_REVIEW" = "true" ]; then
  echo "  Running Periderm deep review..."
  periderm review --deep $PERIDERM_ARGS 2>&1 | head -100
fi

# Build
if [ "$BUILD" = "true" ] && [ -f package.json ]; then
  echo "  Running build..."
  npm run build --if-present || exit 1
fi

# Tests
if [ -n "$TESTS" ] && [ -f package.json ]; then
  for test in $TESTS; do
    echo "  Running $test tests..."
    if [ "$test" = "all" ]; then
      npm test --if-present || exit 1
    else
      npm run test:$test --if-present || npm test --if-present -- --testPathPattern=$test || exit 1
    fi
  done
fi

echo "✅ Pre-push checks passed"
exit 0