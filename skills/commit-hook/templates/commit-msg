#!/bin/sh
# Commit-msg hook - validates commit message format
# Generated by commit-hook skill

. "$(dirname -- "$0")/_/husky.sh" 2>/dev/null || true

# Find the commit-hook skill location
SKILL_DIR=".agents/skills/commit-hook"
if [ ! -d "$SKILL_DIR" ]; then
  SKILL_DIR=".claude/skills/commit-hook"
fi
if [ ! -d "$SKILL_DIR" ]; then
  SKILL_DIR=".gemini/skills/commit-hook"
fi
if [ ! -d "$SKILL_DIR" ]; then
  echo "commit-hook skill not found. Run installer first."
  exit 1
fi

# Read commit message
COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Load config
HOOKRC=".hookrc.json"
if [ ! -f "$HOOKRC" ]; then
  echo "No .hookrc.json found. Using defaults."
  PATTERN="^(feat|fix|docs|style|refactor|perf|test|chore|build|ci|revert)(\(.+\))?: .+"
  MAX_LENGTH=72
else
  PATTERN=$(node -e "console.log(JSON.parse(require('fs').readFileSync('$HOOKRC', 'utf8')).commitMsg.pattern)")
  MAX_LENGTH=$(node -e "console.log(JSON.parse(require('fs').readFileSync('$HOOKRC', 'utf8')).commitMsg.maxLength)")
fi

# Check format
if ! echo "$COMMIT_MSG" | head -1 | grep -qE "$PATTERN"; then
  echo "✖ Invalid commit message format"
  echo "Expected: <type>(<scope>): <description>"
  echo "Types: feat, fix, docs, style, refactor, perf, test, chore, build, ci, revert"
  echo "Example: feat(auth): add login with OAuth"
  exit 1
fi

# Check length
FIRST_LINE=$(echo "$COMMIT_MSG" | head -1)
if [ ${#FIRST_LINE} -gt $MAX_LENGTH ]; then
  echo "✖ Commit message too long (${#FIRST_LINE} > $MAX_LENGTH chars)"
  echo "First line: $FIRST_LINE"
  exit 1
fi

echo "✓ Commit message format valid"
exit 0