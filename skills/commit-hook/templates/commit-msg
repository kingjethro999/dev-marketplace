#!/bin/sh
# Commit-msg hook - validates conventional commits with security footer
# Auto-generated by commit-hook skill

SKILL_DIR=".agents/skills/commit-hook"
[ -d "$SKILL_DIR" ] || SKILL_DIR=".claude/skills/commit-hook"
[ -d "$SKILL_DIR" ] || SKILL_DIR=".gemini/skills/commit-hook"
[ -d "$SKILL_DIR" ] || { echo "commit-hook skill not found"; exit 1; }

CONFIG_FILE="$SKILL_DIR/../../commit-hook.json"
if [ -f "$CONFIG_FILE" ]; then
  REQUIRE_CONVENTIONAL=$(node -e "console.log(JSON.parse(require('fs').readFileSync('$CONFIG_FILE')).commitMsg.requireConventional)")
  REQUIRE_SECURITY_FOOTER=$(node -e "console.log(JSON.parse(require('fs').readFileSync('$CONFIG_FILE')).commitMsg.requireSecurityFooter)")
  SECURITY_KEYS=$(node -e "console.log(JSON.parse(require('fs').readFileSync('$CONFIG_FILE')).commitMsg.securityFooterKeys.join('|'))")
  MAX_LENGTH=$(node -e "console.log(JSON.parse(require('fs').readFileSync('$CONFIG_FILE')).commitMsg.maxLength)")
else
  REQUIRE_CONVENTIONAL=true
  REQUIRE_SECURITY_FOOTER=true
  SECURITY_KEYS="Security|CVE|GHSA|Periderm"
  MAX_LENGTH=72
fi

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")
FIRST_LINE=$(echo "$COMMIT_MSG" | head -1)

# Check length
if [ ${#FIRST_LINE} -gt $MAX_LENGTH ]; then
  echo "✖ Commit message too long (${#FIRST_LINE} > $MAX_LENGTH chars)"
  echo "First line: $FIRST_LINE"
  exit 1
fi

# Check conventional format
if [ "$REQUIRE_CONVENTIONAL" = "true" ]; then
  if ! echo "$FIRST_LINE" | grep -qE '^(feat|fix|docs|style|refactor|perf|test|chore|build|ci|revert)(\(.+\))?: .+'; then
    echo "✖ Invalid commit message format"
    echo "Expected: <type>(<scope>): <subject>"
    echo "Types: feat, fix, docs, style, refactor, perf, test, chore, build, ci, revert"
    echo "Example: feat(auth): add OAuth2 login"
    exit 1
  fi
fi

# Check security footer for security-related commits
if [ "$REQUIRE_SECURITY_FOOTER" = "true" ]; then
  # Check if commit touches security-related files or messages
  if echo "$COMMIT_MSG" | grep -qiE 'security|auth|crypto|secret|token|password|credential|vulnerab|exploit|CVE|GHSA|periderm'; then
    if ! echo "$COMMIT_MSG" | grep -qiE "$SECURITY_KEYS"; then
      echo "✖ Security-related commit missing required footer"
      echo "Add footer: $SECURITY_KEYS: <value>"
      echo "Example: Security: CVE-2024-XXXX / Periderm: scan-abc123"
      exit 1
    fi
  fi
fi

echo "✓ Commit message format valid"
exit 0