#!/bin/sh
# Commit-msg hook - validates conventional commits with security footer
# Auto-generated by commit-hook skill

set -u

REQUIRE_CONVENTIONAL="{{REQUIRE_CONVENTIONAL}}"
REQUIRE_SECURITY_FOOTER="{{REQUIRE_SECURITY_FOOTER}}"
SECURITY_KEYS="{{SECURITY_KEYS}}"
MAX_LENGTH="{{MAX_LENGTH}}"

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
CONFIG_FILE="$REPO_ROOT/commit-hook.json"
if [ -f "$CONFIG_FILE" ] && command -v node >/dev/null 2>&1; then
  eval "$(node -e '
    const fs = require("fs");
    try {
      const cfg = JSON.parse(fs.readFileSync(process.argv[1], "utf8")).commitMsg || {};
      const sh = (v) => JSON.stringify(String(v));
      if (cfg.requireConventional !== undefined) console.log("REQUIRE_CONVENTIONAL=" + sh(Boolean(cfg.requireConventional)));
      if (cfg.requireSecurityFooter !== undefined) console.log("REQUIRE_SECURITY_FOOTER=" + sh(Boolean(cfg.requireSecurityFooter)));
      if (Array.isArray(cfg.securityFooterKeys)) console.log("SECURITY_KEYS=" + sh(cfg.securityFooterKeys.join("|")));
      if (cfg.maxLength !== undefined) console.log("MAX_LENGTH=" + sh(cfg.maxLength));
    } catch {}
  ' "$CONFIG_FILE")"
fi

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(grep -v '^#' "$COMMIT_MSG_FILE")
FIRST_LINE=$(printf '%s\n' "$COMMIT_MSG" | head -n 1)

# Allow automated merge and revert commits
case "$FIRST_LINE" in
  Merge\ *|Revert\ *)
    echo "✓ Commit message format valid (merge/revert)"
    exit 0
    ;;
esac

# Check subject length
FIRST_LEN=$(printf '%s' "$FIRST_LINE" | wc -c | tr -d ' ')
if [ "$FIRST_LEN" -gt "$MAX_LENGTH" ]; then
  echo "✖ Commit message too long ($FIRST_LEN > $MAX_LENGTH chars)"
  echo "First line: $FIRST_LINE"
  exit 1
fi

# Check conventional commit format (supports optional scope and breaking !)
if [ "$REQUIRE_CONVENTIONAL" = "true" ]; then
  if ! printf '%s\n' "$FIRST_LINE" | grep -qE '^(feat|fix|docs|style|refactor|perf|test|chore|build|ci|revert)(\([^)]+\))?!?: .+'; then
    echo "✖ Invalid commit message format"
    echo "Expected: <type>(<scope>): <subject>"
    echo "Types: feat, fix, docs, style, refactor, perf, test, chore, build, ci, revert"
    echo "Example: feat(auth): add OAuth2 login"
    exit 1
  fi
fi

# Check security trailer line (e.g. "Security: CVE-2026-XXXX") for security-related commits
if [ "$REQUIRE_SECURITY_FOOTER" = "true" ]; then
  if printf '%s\n' "$COMMIT_MSG" | grep -qiE 'security|auth|crypto|secret|token|password|credential|vulnerab|exploit|CVE|GHSA|periderm'; then
    if ! printf '%s\n' "$COMMIT_MSG" | grep -qiE "^(${SECURITY_KEYS}):[[:space:]]+.+"; then
      echo "✖ Security-related commit missing required trailer footer"
      echo "Add footer line: <${SECURITY_KEYS}>: <value>"
      echo "Example: Security: CVE-2026-XXXX"
      exit 1
    fi
  fi
fi

echo "✓ Commit message format valid"
exit 0
